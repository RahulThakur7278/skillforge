{
  "name": "skillforge",
  "version": "1.0.0",
  "description": "Career & Skill Intelligence Platform — powered by CognoDB Cloud",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "seed": "cd server && node ../scripts/seed.js",
    "clear-db": "cd server && node ../scripts/clear-db.js",
    "verify-db": "cd server && node ../scripts/verify-connection.js",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "build": "cd client && npm run build",
    "vercel-build": "npm run install:all && npm run build",
    "start": "cd server && npm start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": "18.x"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "neo4j-driver": "^6.2.0"
  }
}
